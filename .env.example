# ============================================================
# .env.example - Plantilla de variables de entorno
# ============================================================
# Copia este archivo como .env y rellena tus valores reales.
# NUNCA commitear el archivo .env a git (contiene llaves privadas).

# SEPOLIA_RPC_URL: URL del RPC de Sepolia (Alchemy o Infura).
# Obtener gratis en: https://sepoliafaucet.com/
# Ejemplo: https://eth-sepolia.g.alchemy.com/v2/TU_API_KEY_AQUI
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/TU_API_KEY_AQUI

# PRIVATE_KEY: Llave privada del wallet que desplegara el contrato.
# SIN el prefijo 0x.
# NUNCA usar la llave principal de MetaMask. Crear un wallet dedicado.
# Ejemplo: ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
PRIVATE_KEY=tu_llave_privada_sin_0x

# ETHERSCAN_API_KEY: API key de Etherscan para verificar contratos.
# Obtener gratis en: https://etherscan.io/myapikey
# Ejemplo: ABC123def456GHI789jkl012MNO345pqr678STU
ETHERSCAN_API_KEY=tu_api_key_de_etherscan

# INITIAL_SUPPLY: Supply inicial del token en unidades base (18 decimales).
# 1000000000000000000000000 = 1,000,000 tokens
# 10000000000000000000000000 = 10,000,000 tokens
INITIAL_SUPPLY=1000000000000000000000000
